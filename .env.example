# ==============================================================================
# MedusaJS Dokploy Deployment Environment Variables
# ==============================================================================

# Application Ports & Environment
NODE_ENV=production
PORT=9000

# Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters
COOKIE_SECRET=super_secret_cookie_key_at_least_32_characters

# PostgreSQL Database Configuration
POSTGRES_USER=medusa
POSTGRES_PASSWORD=super_secure_postgres_password
POSTGRES_DB=medusa_db

# Medusa Application URLs & CORS
# Replace these with your actual domains configured in Dokploy
MEDUSA_BACKEND_URL=https://api.yourdomain.com
STORE_CORS=https://yourstore.com
ADMIN_CORS=https://api.yourdomain.com,https://admin.yourdomain.com
AUTH_CORS=https://api.yourdomain.com,https://admin.yourdomain.com,https://yourstore.com
